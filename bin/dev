#!/usr/bin/env bash
# 開発用: app/ と projects/ をホストからbind mountしてコンテナを起動する。
#
# app.rb は __dir__(app.rbの場所)からの相対パスで projects/ を解決している
# ( PROJECTS_ROOT = File.expand_path("../projects", __dir__) )ため、
# app/ の中身は Dockerfile と同じ配置(WORKDIR /root 直下)になるようマウントする。
set -euo pipefail

cd "$(dirname "$0")/.."

# RACK_ENV=development: DockerfileはイメージをそのままCMD起動した場合に備えて
# production(キャッシュ有効)をデフォルトにしているので、ここで開発用に上書きする
# (app.rb のキャッシュ制御ヘッダーの分岐を参照)。
docker run --rm -p 4567:4567 \
  -e RACK_ENV=development \
  -v "$(pwd)/app/app.rb:/root/app.rb" \
  -v "$(pwd)/app/public:/root/public" \
  -v "$(pwd)/app/views:/root/views" \
  -v "$(pwd)/app/funicular:/root/funicular" \
  -v "$(pwd)/projects:/projects" \
  picoruby-ide "$@"
